{
  "name": "deepscholar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "dev:local": "node scripts/dev-switch.cjs local",
    "dev:remote": "node scripts/dev-switch.cjs remote",
    "reset:local": "node -e \"require('fs').rmSync('prisma/dev.db',{force:true});console.log('Local DB deleted')\"",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "test:parser": "tsx scripts/test-parser.ts",
    "test:pipeline": "tsx scripts/test-extraction-pipeline.ts",
    "test:extractor": "tsx test_extractors.ts",
    "test:conversation": "tsx scripts/test-conversation-detection.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test e2e/smoke.spec.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "db:seed:small": "tsx scripts/seed.ts --users 10 --briefs 50 --sources 20",
    "db:seed:medium": "tsx scripts/seed.ts --users 50 --briefs 200 --sources 100",
    "db:seed:large": "tsx scripts/seed.ts --users 200 --briefs 1000 --sources 500 --power-users --viral",
    "db:seed:xl": "tsx scripts/seed.ts --users 500 --briefs 5000 --sources 1000 --power-users --viral",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@phosphor-icons/react": "github:phosphor-icons/react",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/query-sync-storage-persister": "^5.90.16",
    "@tanstack/react-query": "^5.90.14",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-query-persist-client": "^5.90.16",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "debounce": "^2.2.0",
    "diff": "^7.0.0",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.5.1",
    "faker-js": "^1.0.0",
    "framer-motion": "^12.4.7",
    "geist": "^1.3.0",
    "isomorphic-dompurify": "^2.35.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.476.0",
    "next": "^15.1.11",
    "next-auth": "5.0.0-beta.25",
    "obscenity": "^0.4.6",
    "puppeteer": "^24.10.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.0.0",
    "recharts": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.59.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "npm@10.9.0"
}
