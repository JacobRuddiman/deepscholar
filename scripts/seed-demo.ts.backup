// Script to seed demo user and their content
import { db } from "../src/server/db";
import { faker } from '@faker-js/faker';

const DEMO_USER_EMAIL = 'demo@deepscholar.local';
const DEMO_USER_ID = 'demo-user-id';

async function seedDemoUser() {
  console.log('🎭 Seeding demo user and content...');

  // Check if demo user exists
  let demoUser = await db.user.findUnique({
    where: { email: DEMO_USER_EMAIL },
  });

  if (!demoUser) {
    console.log('Creating demo user...');
    demoUser = await db.user.create({
      data: {
        id: DEMO_USER_ID,
        email: DEMO_USER_EMAIL,
        name: 'Demo User',
        emailVerified: new Date(),
        image: 'data:image/svg+xml;base64,',
        isAdmin: true,
        isSeedData: false, // Demo user is not seed data
        createdAt: new Date('2024-01-01'),
      },
    });
    console.log('✅ Demo user created');
  } else {
    console.log('✅ Demo user already exists');
  }

  // Get or create AI models
  let researchModel = await db.researchAIModel.findFirst({
    where: { name: 'GPT-4' },
  });

  if (!researchModel) {
    console.log('Creating research AI model...');
    researchModel = await db.researchAIModel.create({
      data: {
        name: 'GPT-4',
        provider: 'OpenAI',
        version: '1.0',
      },
    });
  }

  // Get or create categories
  const categoryNames = [
    'Technology',
    'Science',
    'Health & Medicine',
    'Environment',
    'Business',
  ];

  const categories = [];
  for (const name of categoryNames) {
    let category = await db.category.findFirst({
      where: { name },
    });

    if (!category) {
      category = await db.category.create({
        data: {
          name,
          description: `Research and insights in ${name}`,
        },
      });
    }
    categories.push(category);
  }

  // Get or create sources
  const sourceData = [
    { title: 'Nature Scientific Journal', url: 'https://www.nature.com' },
    { title: 'Science Magazine', url: 'https://www.science.org' },
    { title: 'MIT Technology Review', url: 'https://www.technologyreview.com' },
    { title: 'The New York Times', url: 'https://www.nytimes.com' },
    { title: 'Harvard Business Review', url: 'https://hbr.org' },
  ];

  const sources = [];
  for (const sourceInfo of sourceData) {
    let source = await db.source.findFirst({
      where: { title: sourceInfo.title },
    });

    if (!source) {
      source = await db.source.create({
        data: sourceInfo,
      });
    }
    sources.push(source);
  }

  // Check if demo user already has briefs
  const existingBriefs = await db.brief.count({
    where: { userId: demoUser.id },
  });

  if (existingBriefs > 0) {
    console.log(`✅ Demo user already has ${existingBriefs} briefs`);
    return {
      success: true,
      message: 'Demo user already has content',
    };
  }

  // Create demo briefs
  console.log('Creating demo briefs...');
  const demoBriefs = [
    {
      title: 'Advances in Quantum Computing: A Comprehensive Review',
      prompt: 'Analyze the current state of quantum computing and its future implications',
      abstract: 'This research brief explores the latest developments in quantum computing, including recent breakthroughs in quantum supremacy and practical applications. Key findings highlight transformative potential while acknowledging implementation challenges.',
      response: `Quantum computing has made significant strides in recent years, with major tech companies and research institutions achieving remarkable milestones in both hardware and software development.

Recent breakthroughs include achieving quantum supremacy on specific tasks, demonstrating quantum advantage in optimization problems, and developing more stable qubit architectures. Companies like IBM, Google, and startups are racing to build practical quantum computers.

Key applications emerging include drug discovery and molecular simulation, cryptography and security, financial modeling and risk analysis, and optimization problems in logistics and supply chain management. These applications could revolutionize industries by solving problems intractable for classical computers.

However, significant challenges remain including qubit stability and coherence times, error correction and fault tolerance, scalability to millions of qubits, and the need for cryogenic operating temperatures. The path to practical, large-scale quantum computing requires continued innovation in materials science, control systems, and algorithm development.`,
      thinking: 'To provide a comprehensive overview, I analyzed recent papers from Nature, Science, and arXiv focusing on quantum computing developments. I prioritized peer-reviewed research and cross-referenced findings across multiple authoritative sources to ensure accuracy.',
      categories: [categories[0], categories[1]], // Technology, Science
      sources: [sources[0], sources[1], sources[2]],
      accuracy: 4.7,
      readTime: 8,
      viewCount: 1247,
    },
    {
      title: 'Machine Learning in Healthcare: Transforming Patient Outcomes',
      prompt: 'Examine the impact of machine learning on healthcare delivery and patient outcomes',
      abstract: 'An analysis of how machine learning is transforming healthcare, from diagnostic imaging to drug discovery. Evidence-based insights guide strategic decision-making for healthcare stakeholders.',
      response: `Machine learning applications in healthcare have expanded rapidly, showing promising results across multiple domains with measurable improvements in patient outcomes and operational efficiency.

In diagnostic imaging, AI systems now match or exceed human radiologists in detecting certain conditions, particularly in mammography, retinal imaging, and lung nodule detection. These systems analyze thousands of images to identify patterns invisible to human eyes, enabling earlier detection of diseases.

Predictive analytics leverage patient data to forecast disease progression, hospital readmissions, and treatment responses. This enables proactive interventions and personalized treatment plans that improve outcomes while reducing costs.

Drug discovery has been revolutionized by machine learning, reducing the time and cost of identifying promising compounds. AI models can predict molecular behavior, optimize drug candidates, and identify new uses for existing medications.

Critical challenges include data privacy and security concerns, algorithmic bias and fairness, regulatory approval pathways, and integration with existing clinical workflows. Success requires collaboration between technologists, clinicians, and regulators to ensure safe, effective deployment.`,
      thinking: 'I focused on peer-reviewed studies and clinical trials to ensure accuracy in this sensitive domain. The analysis balanced technological capabilities with practical clinical considerations and ethical implications.',
      categories: [categories[0], categories[2]], // Technology, Health & Medicine
      sources: [sources[0], sources[3], sources[4]],
      accuracy: 4.8,
      readTime: 12,
      viewCount: 892,
    },
    {
      title: 'Climate Change Mitigation Through Renewable Energy Technologies',
      prompt: 'Assess the role of renewable energy in addressing climate change',
      abstract: 'Examining the role of renewable energy technologies in addressing climate change challenges. Strategic implications guide adaptation and innovation strategies for policymakers and industry leaders.',
      response: `Renewable energy technologies have become increasingly cost-effective and efficient, offering viable solutions for climate change mitigation that were unimaginable just a decade ago.

Solar photovoltaic costs have declined by over 90% since 2010, making solar the cheapest source of electricity in history in many regions. Wind power has seen similar cost reductions, while battery storage technologies enable grid stability with high renewable penetration.

The transition to renewables offers multiple co-benefits beyond emissions reduction including energy independence and security, job creation in manufacturing and installation, improved air quality and public health, and economic opportunities in emerging markets.

However, significant challenges remain in grid infrastructure and energy storage, intermittency and reliability concerns, manufacturing supply chains and critical materials, and just transition for fossil fuel-dependent communities. Addressing these requires coordinated policy, technological innovation, and substantial investment.

Pathways to decarbonization include rapid deployment of proven technologies, continued innovation in emerging areas, supportive policy frameworks and carbon pricing, and international cooperation on technology transfer. Success requires action across all sectors of the economy.`,
      thinking: 'I analyzed IPCC reports, energy statistics from IEA and IRENA, and recent technological developments to provide a balanced perspective on renewable energy potential and limitations.',
      categories: [categories[0], categories[3]], // Technology, Environment
      sources: [sources[0], sources[1], sources[3]],
      accuracy: 4.6,
      readTime: 10,
      viewCount: 634,
    },
    {
      title: 'The Future of Work: Remote Work and Digital Transformation',
      prompt: 'Analyze the transformation of work in the post-pandemic era',
      abstract: 'This brief examines historical patterns, current dynamics, and future scenarios. Insights support adaptive strategy development in uncertain business environment.',
      response: `The COVID-19 pandemic accelerated digital transformation and remote work adoption by years, fundamentally changing how organizations operate and employees work. These changes appear largely permanent.

Remote and hybrid work models have become standard in knowledge work sectors, with surveys showing the majority of employees prefer flexible arrangements. This shift has implications for real estate, urban planning, talent acquisition, and organizational culture.

Digital collaboration tools have matured rapidly, enabling effective remote teamwork, though challenges remain in areas like innovation, mentorship, and maintaining company culture. Organizations are experimenting with various hybrid models to balance flexibility with in-person collaboration.

The geographic decoupling of work and location creates opportunities for talent access across regions, cost optimization through distributed teams, and improved work-life balance for employees. However, it also raises concerns about overwork, isolation, and equity in access to flexible arrangements.

Looking forward, key trends include continued tool innovation, new management practices, redefinition of physical office space, and evolution of labor markets and compensation. Success requires intentional design of hybrid work systems that support both productivity and employee wellbeing.`,
      thinking: 'This analysis synthesized research on remote work productivity, employee surveys, and organizational case studies. The investigation employed both exploratory and confirmatory methods to understand this rapidly evolving phenomenon.',
      categories: [categories[0], categories[4]], // Technology, Business
      sources: [sources[3], sources[4]],
      accuracy: 4.5,
      readTime: 9,
      viewCount: 521,
    },
    {
      title: 'CRISPR Gene Editing: Therapeutic Applications and Ethical Considerations',
      prompt: 'Examine the current state and ethical implications of CRISPR technology',
      abstract: 'A rigorous investigation of fundamental questions with far-reaching implications. This research combines methodological innovation with substantive contribution to the field of genetic medicine.',
      response: `CRISPR-Cas9 gene editing technology has revolutionized biological research and opened new therapeutic possibilities, while raising profound ethical questions about the boundaries of genetic modification.

Therapeutic applications have advanced rapidly, with clinical trials underway for sickle cell disease, beta-thalassemia, certain cancers, and inherited blindness. Early results show promising efficacy and safety profiles, bringing hope to patients with previously untreatable genetic conditions.

The technology works by using a guide RNA to direct Cas9 enzyme to specific DNA sequences, where it makes precise cuts allowing genes to be added, removed, or modified. Improvements in precision and delivery methods continue to expand potential applications.

Ethical considerations include germline editing and heritable changes, equitable access to expensive treatments, potential for enhancement beyond therapy, and long-term effects of genetic modifications. International guidelines are evolving but remain inconsistent across jurisdictions.

The scientific community faces difficult questions about appropriate governance, balancing innovation with safety, ensuring democratic input on transformative technology, and preventing misuse. These decisions will shape the future of human genetic modification.`,
      thinking: 'Critical evaluation of sources ensured reliability and validity of conclusions. I examined both peer-reviewed research and bioethics literature to provide comprehensive perspective on this complex topic.',
      categories: [categories[1], categories[2]], // Science, Health & Medicine
      sources: [sources[0], sources[1]],
      accuracy: 4.9,
      readTime: 11,
      viewCount: 789,
    },
  ];

  const createdBriefs = [];
  for (const briefData of demoBriefs) {
    const brief = await db.brief.create({
      data: {
        title: briefData.title,
        prompt: briefData.prompt,
        abstract: briefData.abstract,
        response: briefData.response,
        thinking: briefData.thinking,
        slug: faker.lorem.slug(),
        published: true,
        isDraft: false,
        userId: demoUser.id,
        modelId: researchModel.id,
        accuracy: briefData.accuracy,
        readTime: briefData.readTime,
        viewCount: briefData.viewCount,
        isSeedData: false, // Demo user content is not seed data
        categories: {
          connect: briefData.categories.filter(c => c !== undefined).map(c => ({ id: c.id })),
        },
        sources: {
          connect: briefData.sources.filter(s => s !== undefined).map(s => ({ id: s.id })),
        },
        createdAt: faker.date.recent({ days: 30 }),
      },
    });

    // Create brief references
    for (let i = 0; i < Math.min(2, briefData.sources.length); i++) {
      const source = briefData.sources[i];
      if (!source) continue;

      await db.briefReference.create({
        data: {
          briefId: brief.id,
          sourceId: source.id,
          highlightedText: 'Recent studies demonstrate significant improvements',
          context: 'This finding aligns with broader research trends in the field',
        },
      });
    }

    createdBriefs.push(brief);
  }

  console.log(`✅ Created ${createdBriefs.length} briefs for demo user`);

  // Create user token balance
  await db.userToken.upsert({
    where: { userId: demoUser.id },
    update: { balance: 1000 },
    create: {
      userId: demoUser.id,
      balance: 1000,
    },
  });

  // Create user recommendation
  await db.userRecommendation.upsert({
    where: { userId: demoUser.id },
    update: {
      topCategories: categoryNames.slice(0, 3),
      topCreatedCategories: categoryNames.slice(0, 3),
      relevantKeywords: ['quantum', 'computing', 'machine', 'learning', 'climate', 'energy'],
      engagementScore: 85,
      lastSearchQueries: ['quantum computing', 'machine learning healthcare', 'renewable energy'],
      lastInteractionDate: new Date(),
    },
    create: {
      userId: demoUser.id,
      topCategories: categoryNames.slice(0, 3),
      topCreatedCategories: categoryNames.slice(0, 3),
      relevantKeywords: ['quantum', 'computing', 'machine', 'learning', 'climate', 'energy'],
      engagementScore: 85,
      lastSearchQueries: ['quantum computing', 'machine learning healthcare', 'renewable energy'],
      lastInteractionDate: new Date(),
    },
  });

  console.log('✅ Demo user setup complete!');
  console.log(`📧 Email: ${DEMO_USER_EMAIL}`);
  console.log(`📝 Briefs: ${createdBriefs.length}`);
  console.log(`💰 Tokens: 1000`);

  return {
    success: true,
    user: demoUser,
    briefsCount: createdBriefs.length,
  };
}

// Run the seed
seedDemoUser()
  .then((result) => {
    console.log('✨ Demo user seeding completed successfully');
    process.exit(0);
  })
  .catch((error) => {
    console.error('❌ Demo user seeding failed:', error);
    process.exit(1);
  });
